# FLEETGUARD Backend Environment Configuration
# Copy this file to .env:
#   copy .env.example .env

# --- Database Configuration ---
# Default SQLite database file (stored in backend/fleet.db)
DATABASE_URL=sqlite:///./fleet.db
# PostgreSQL Alternative (optional):
# DATABASE_URL=postgresql+psycopg2://fleet_user:fleet_password@localhost:5432/fleet_db

# --- Authentication & Security ---
SECRET_KEY=dev-secret-key-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Allowed Frontend Origins for CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# --- Live Camera & AI Driver Monitoring ---
# Set to 'live' for real camera inference, or 'simulation' for demo mode
AI_MODE=live

# Camera Index or Stream URL:
# 0 = Built-in laptop webcam
# 1 = External USB camera
# For DroidCam over Wi-Fi, provide URL or comma-separated fallbacks:
# AI_CAMERA_INDEX=http://192.168.0.4:4747/video,0,1
AI_CAMERA_INDEX=0

# Cooldown between auto-generated incident reports for the same driver (seconds)
AI_EVENT_COOLDOWN_SECONDS=30

# --- Computer Vision Thresholds & Durations ---
AI_EAR_THRESHOLD=0.19
AI_MAR_THRESHOLD=0.25
AI_YAW_THRESHOLD_DEGREES=25.0
AI_DROWSINESS_DURATION_SECONDS=0.8
AI_EYE_CLOSURE_WARNING_SECONDS=0.5
AI_YAWN_DURATION_SECONDS=1.0
AI_DISTRACTION_DURATION_SECONDS=1.5
AI_ABSENCE_GRACE_SECONDS=2.5
AI_TARGET_FPS=15
AI_CAMERA_RECONNECT_MAX_RETRIES=5

# --- Pretrained YOLOv8 Mobile Phone Detection ---
AI_PHONE_DETECTION_ENABLED=True
AI_PHONE_MODEL=yolov8n.pt
AI_PHONE_CONFIDENCE_THRESHOLD=0.35
AI_PHONE_USAGE_DURATION_SECONDS=1.5
AI_PHONE_WARNING_DURATION_SECONDS=0.6

# --- GPS Engine Settings ---
# 'simulation' (default) or 'live'
GPS_MODE=simulation

# --- Evidence Video Storage & Retention (Phase 3) ---
EVIDENCE_STORAGE_DIR=data/evidence
EVIDENCE_MAX_STORAGE_MB=500
EVIDENCE_RETENTION_DAYS=7
EVIDENCE_RESERVED_RECORDING_MB=25

# --- Environment ---
ENVIRONMENT=development
