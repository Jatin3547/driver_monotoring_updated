# Copy this file to .env and adjust values for your machine.
# Never commit a real .env file — it is git-ignored on purpose.

# --- Database -----------------------------------------------------------
# Default: local SQLite file, zero setup required. Good enough for the
# student/demo use case described in the project brief.
DATABASE_URL=sqlite:///./fleet.db

# To use PostgreSQL instead (once you have a server running locally):
# DATABASE_URL=postgresql+psycopg2://fleet_user:fleet_password@localhost:5432/fleet_db

# --- Authentication -------------------------------------------------------
# Generate a real secret for anything beyond local development, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# --- CORS -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- GPS --------------------------------------------------------------
# "simulation" generates fake-but-labelled-as-fake moving vehicles.
# "live" expects a real GPS ingestion source (not implemented — see README).
GPS_MODE=demo

# --- AI / driver monitoring ----------------------------------------------
# "simulation" replays labelled fake detection events (default; needs no
# camera or heavy CV libraries).
# "live" runs real OpenCV/MediaPipe/YOLO inference against a webcam --
# requires `pip install -r requirements-ai.txt` and a working camera.
AI_MODE=demo

# --- Misc -------------------------------------------------------------
ENVIRONMENT=development

# Camera index for AI_MODE=live (0 = laptop webcam, 1 or 2 = DroidCam phone camera)
AI_CAMERA_INDEX=0
# Minimum seconds between auto-generated incidents of the same type for
# the same driver (prevents one continuous violation from spamming the
# incidents table).
AI_EVENT_COOLDOWN_SECONDS=30
