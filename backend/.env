# Database Configuration (SQLite default for local development)
DATABASE_URL=sqlite:///./fleet.db

# Authentication Security
SECRET_KEY=dev-secret-key-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed Frontend Origins for CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Live Camera AI Driver Monitoring Settings
AI_MODE=live
AI_CAMERA_INDEX=0
AI_EVENT_COOLDOWN_SECONDS=30

# Computer Vision Thresholds and Durations
AI_EAR_THRESHOLD=0.125
AI_MAR_THRESHOLD=0.25
AI_YAW_THRESHOLD_DEGREES=25.0
AI_DROWSINESS_DURATION_SECONDS=1.0
AI_EYE_CLOSURE_WARNING_SECONDS=0.6
AI_YAWN_DURATION_SECONDS=1.0
AI_DISTRACTION_DURATION_SECONDS=2.0
AI_ABSENCE_GRACE_SECONDS=2.5
AI_TARGET_FPS=15
AI_CAMERA_RECONNECT_MAX_RETRIES=5

# Pretrained YOLOv8 Mobile Phone Detection Settings
AI_PHONE_DETECTION_ENABLED=True
AI_PHONE_MODEL=yolov8n.pt
AI_PHONE_CONFIDENCE_THRESHOLD=0.35
AI_PHONE_USAGE_DURATION_SECONDS=1.5
AI_PHONE_WARNING_DURATION_SECONDS=0.6

# GPS Engine Settings
GPS_MODE=simulation

ENVIRONMENT=development

