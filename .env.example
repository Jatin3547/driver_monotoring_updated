# FLEETGUARD Frontend Environment Configuration
# Copy this file to .env:
#   copy .env.example .env

# Set to 'false' to connect the React UI to the real Python backend
# Set to 'true' to use standalone mock data without a backend
VITE_USE_MOCK=false

# Real Backend Base API URL (FastAPI)
VITE_API_BASE_URL=http://127.0.0.1:8000/api
